# ==============================================================================
# Conversational Data Analysis Assistant - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#    copy .env.example .env (Windows CMD) or cp .env.example .env (PowerShell/Bash)
# 2. Supply your Google Gemini API Key below.
# 3. Never commit your actual '.env' file to version control.
# ==============================================================================

# --- LLM Provider Configuration ---
# Choose default provider: "gemini" or "ollama"
DEFAULT_LLM_PROVIDER=gemini

# --- Google Gemini Configuration ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GOOGLE_API_KEY=YOUR_GCP_API_KEY_HERE
# --- Ollama Configuration (Local LLM fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Application Security & Execution Settings ---
# Maximum execution time (in seconds) for untrusted generated code
EXECUTION_TIMEOUT_SECONDS=10

# Maximum rows permitted for uploaded datasets (safeguard against memory issues)
MAX_DATASET_ROWS=100000

# Maximum file size in MB
MAX_UPLOAD_SIZE_MB=50

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
